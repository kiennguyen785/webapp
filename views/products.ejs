<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Sản phẩm</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<header class="header">
  <a href="/" class="logo">Sports Shop</a>

  <form action="/products" method="GET" class="search">
    <input type="text" name="q" placeholder="Tìm sản phẩm thể thao...">
    <button>Tìm</button>
  </form>

  <nav>
    <a href="/">Trang chủ</a>
    <a href="/products">Sản phẩm</a>
    <a href="/cart">Giỏ hàng</a>

    <% if (user) { %>
      <div class="user-menu">
        <span><%= user.full_name %></span>
        <div class="dropdown">
  <a href="/profile">Thông tin cá nhân</a>
  <a href="/orders">Lịch sử đặt hàng</a>

  <% if (user.role === 'admin') { %>
    <a href="/admin/users">Quản lý tài khoản</a>
    <a href="/admin/products">Quản lý sản phẩm</a>
  <% } %>

  <% if (user.role === 'seller') { %>
    <a href="/seller/products">Quản lý sản phẩm</a>
  <% } %>

  <a href="/auth/logout">Đăng xuất</a>
</div>      </div>
    <% } else { %>
      <a href="/auth/login">Đăng nhập</a>
      <a href="/auth/register">Đăng ký</a>
    <% } %>
  </nav>
</header>


<main class="page-wrap">
  <h1>Danh sách sản phẩm</h1>

  <form action="/products" method="GET" class="filter">
    <input type="text" name="q" value="<%= q || '' %>" placeholder="Tìm sản phẩm...">

    <select name="category">
      <option value="">Tất cả danh mục</option>
      <% categories.forEach(c => { %>
        <option value="<%= c.category %>" <%= category === c.category ? 'selected' : '' %>>
          <%= c.category %>
        </option>
      <% }) %>
    </select>

    <button>Lọc</button>
  </form>

  <div class="grid">
    <% products.forEach(p => { %>
      <div class="card">
        <a href="/products/<%= p.id %>">
          <img src="<%= p.image_url %>" alt="<%= p.product_name %>">
          <h3><%= p.product_name %></h3>
        </a>
        <p><%= p.brand %></p>
        <p><%= p.category %></p>
        <strong><%= Number(p.price).toLocaleString('vi-VN') %> đ</strong>
        <form action="/cart/add/<%= p.id %>" method="POST">
          <button>Thêm vào giỏ</button>
        </form>
      </div>
    <% }) %>
  </div>
</main>

<footer class="footer">
  <div class="footer-grid">
    <div>
      <h3>Sports Shop</h3>
      <p>Website bán đồ thể thao trực tuyến.</p>
    </div>
    <div>
      <h4>Liên hệ</h4>
      <p>Email: support@sportshop.vn</p>
      <p>SĐT: 0123456789</p>
    </div>
    <div>
      <h4>Danh mục</h4>
      <p>Giày chạy bộ</p>
      <p>Bóng đá</p>
      <p>Cầu lông</p>
    </div>
  </div>
</footer>

</body>
</html>