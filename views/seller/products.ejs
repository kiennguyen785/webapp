<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Người bán - Quản lý sản phẩm</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
  <header class="header">
    <a href="/" class="logo">Sports Shop</a>

    <form action="/products" method="GET" class="search">
      <input type="text" name="q" placeholder="Tìm sản phẩm...">
      <button type="submit">Tìm</button>
    </form>

    <nav>
      <a href="/">Trang chủ</a>
      <a href="/products">Sản phẩm</a>
      <a href="/cart">Giỏ hàng</a>

      <% if (user) { %>
        <div class="user-menu">
          <span><%= user.full_name %></span>

          <div class="dropdown">
            <% if (user.role === 'seller') { %>
              <a href="/seller/products">Quản lý sản phẩm</a>
            <% } %>

            <% if (user.role === 'admin') { %>
              <a href="/admin/users">Quản lý tài khoản</a>
              <a href="/admin/products">Quản lý sản phẩm</a>
            <% } %>

            <a href="/auth/logout">Đăng xuất</a>
          </div>
        </div>
      <% } else { %>
        <a href="/auth/login">Đăng nhập</a>
        <a href="/auth/register">Đăng ký</a>
      <% } %>
    </nav>
  </header>

  <main class="page-wrap">
    <h1>Quản lý sản phẩm của tôi</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <% if (success) { %>
      <p style="color: green; text-align: center;"><%= success %></p>
    <% } %>
  </main>

  <table>
    <thead>
      <tr>
        <th colspan="2">
          <% if (editProduct) { %>
            Sửa sản phẩm
          <% } else { %>
            Thêm sản phẩm mới
          <% } %>
        </th>
      </tr>
    </thead>

    <tbody>
      <tr>
        <td colspan="2">
          <% if (editProduct) { %>
            <form action="/seller/products/<%= editProduct.product_id %>/edit" method="POST">
          <% } else { %>
            <form action="/seller/products/add" method="POST">
          <% } %>

            <div class="filter" style="padding: 0; flex-wrap: wrap;">
              <input
                type="text"
                name="product_name"
                placeholder="Tên sản phẩm"
                value="<%= editProduct ? editProduct.product_name : '' %>"
                required
              >

              <input
                type="number"
                name="brand_id"
                placeholder="Brand ID"
                value="<%= editProduct ? editProduct.brand_id : '' %>"
                required
              >

              <input
                type="number"
                name="category_id"
                placeholder="Category ID"
                value="<%= editProduct ? editProduct.category_id : '' %>"
                required
              >

              <input
                type="number"
                name="quantity"
                placeholder="Số lượng"
                min="0"
                value="<%= editProduct ? (editProduct.quantity || 0) : 0 %>"
              >

              <input
                type="text"
                name="image_url"
                placeholder="Đường dẫn ảnh"
                value="<%= editProduct ? (editProduct.image_url || '') : '' %>"
              >
            </div>

            <div style="margin-top: 12px;">
              <textarea
                name="description"
                placeholder="Mô tả sản phẩm"
                style="width: 100%; min-height: 80px; padding: 12px; border: 1px solid #ddd; border-radius: 12px;"
              ><%= editProduct ? (editProduct.description || '') : '' %></textarea>
            </div>

            <div style="margin-top: 12px;">
              <textarea
                name="specifications"
                placeholder="Thông số kỹ thuật"
                style="width: 100%; min-height: 80px; padding: 12px; border: 1px solid #ddd; border-radius: 12px;"
              ><%= editProduct ? (editProduct.specifications || '') : '' %></textarea>
            </div>

            <div style="margin-top: 14px; display: flex; gap: 24px; align-items: center; flex-wrap: wrap;">
              <label>
                <input
                  type="checkbox"
                  name="is_promotion"
                  <%= editProduct && editProduct.is_promotion ? 'checked' : '' %>
                >
                Sản phẩm khuyến mãi
              </label>

              <label>
                <input
                  type="checkbox"
                  name="is_active"
                  <%= !editProduct || editProduct.is_active ? 'checked' : '' %>
                >
                Đang bán / hiển thị
              </label>
            </div>

            <div style="margin-top: 16px; display: flex; gap: 10px;">
              <% if (editProduct) { %>
                <button type="submit">Lưu thay đổi</button>

                <a href="/seller/products">
                  <button type="button">Hủy sửa</button>
                </a>
              <% } else { %>
                <button type="submit">Thêm sản phẩm</button>
              <% } %>
            </div>
          </form>
        </td>
      </tr>
    </tbody>
  </table>

  <main class="page-wrap">
    <h1>Danh sách sản phẩm của tôi</h1>
  </main>

  <table>
    <thead>
      <tr>
        <th>Ảnh</th>
        <th>Sản phẩm</th>
        <th>Brand ID</th>
        <th>Category ID</th>
        <th>Số lượng</th>
        <th>Khuyến mãi</th>
        <th>Trạng thái</th>
        <th>Thao tác</th>
      </tr>
    </thead>

    <tbody>
      <% if (products && products.length > 0) { %>
        <% products.forEach(p => { %>
          <tr>
            <td>
              <% if (p.image_url) { %>
                <img src="<%= p.image_url %>" alt="<%= p.product_name %>" class="thumb">
              <% } else { %>
                Không có ảnh
              <% } %>
            </td>

            <td>
              <strong><%= p.product_name %></strong>

              <% if (p.description) { %>
                <div class="unit-price">
                  <%= p.description.length > 80 ? p.description.substring(0, 80) + '...' : p.description %>
                </div>
              <% } %>
            </td>

            <td><%= p.brand_id %></td>

            <td><%= p.category_id %></td>

            <td>
              <strong><%= p.quantity || 0 %></strong>
            </td>

            <td>
              <% if (p.is_promotion) { %>
                Có
              <% } else { %>
                Không
              <% } %>
            </td>

            <td>
              <% if (p.is_active) { %>
                Đang bán
              <% } else { %>
                Đã ẩn
              <% } %>
            </td>

            <td>
              <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <a href="/seller/products/<%= p.product_id %>/edit">
                  <button type="button">Sửa</button>
                </a>

                <% if (p.is_active) { %>
                  <form
                    action="/seller/products/<%= p.product_id %>/delete"
                    method="POST"
                    onsubmit="return confirm('Bạn có chắc muốn ẩn sản phẩm này không?');"
                  >
                    <button type="submit">Xóa</button>
                  </form>
                <% } else { %>
                  <form action="/seller/products/<%= p.product_id %>/restore" method="POST">
                    <button type="submit">Khôi phục</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="8" style="text-align: center;">
            Bạn chưa có sản phẩm nào
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <footer class="footer">
    <div class="footer-grid">
      <div>
        <h3>Sports Shop</h3>
        <p>Website bán đồ thể thao trực tuyến.</p>
      </div>

      <div>
        <h4>Liên hệ</h4>
        <p>Email: support@sportshop.vn</p>
        <p>SĐT: 0123456789</p>
      </div>

      <div>
        <h4>Danh mục</h4>
        <p>Giày chạy bộ</p>
        <p>Bóng đá</p>
        <p>Cầu lông</p>
      </div>
    </div>
  </footer>
</body>
</html>