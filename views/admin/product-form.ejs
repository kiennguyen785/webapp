<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<header class="header">
  <a href="/" class="logo">Sports Shop</a>

  <nav>
    <a href="/">Trang chủ</a>
    <a href="/admin/users">Quản lý tài khoản</a>
    <a href="/admin/products">Quản lý sản phẩm</a>
    <a href="/auth/logout">Đăng xuất</a>
  </nav>
</header>

<div class="form-box">
  <h1><%= title %></h1>

  <form action="<%= action %>" method="POST">
    <label>Tên sản phẩm</label>
    <input 
      type="text" 
      name="product_name" 
      value="<%= product ? product.product_name : '' %>" 
      required
    >

    <label>Thương hiệu</label>
    <input 
      type="text"
      name="brand"
      list="brand-list"
      value="<%= product ? product.brand : '' %>"
      placeholder="Chọn hoặc nhập thương hiệu mới"
      required
    >

    <datalist id="brand-list">
      <% brands.forEach(b => { %>
        <option value="<%= b.brand %>"></option>
      <% }) %>
    </datalist>

    <label>Danh mục</label>
    <input 
      type="text" 
      name="category" 
      value="<%= product ? product.category : '' %>" 
      required
    >

    <label>Giá</label>
    <input 
      type="number" 
      name="price" 
      value="<%= product ? product.price : 0 %>" 
      min="0"
      required
    >

    <label>Số lượng</label>
    <input 
      type="number" 
      name="quantity" 
      value="<%= product ? product.quantity : 0 %>"
      min="0"
    >

    <label>Link ảnh</label>
    <input 
      type="text" 
      name="image_url" 
      value="<%= product ? product.image_url : '' %>"
    >

    <label>Người bán</label>
    <select name="seller_id" class="auth-select">
      <option value="">Chưa gán người bán</option>

      <% sellers.forEach(s => { %>
        <option 
          value="<%= s.id %>"
          <%= product && Number(product.seller_id) === Number(s.id) ? 'selected' : '' %>
        >
          <%= s.full_name %> - <%= s.email %>
        </option>
      <% }) %>
    </select>

    <label>Mô tả</label>
    <textarea 
      name="description" 
      rows="5" 
      style="width:100%; padding:10px; border:1px solid #ccc; border-radius:8px;"
    ><%= product ? product.description : '' %></textarea>

    <button type="submit">Lưu</button>
  </form>

  <p>
    <a href="/admin/products">← Quay lại quản lý sản phẩm</a>
  </p>
</div>

</body>
</html>