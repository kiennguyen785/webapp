<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Quản lý sản phẩm</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<header class="header">
  <a href="/" class="logo">Sports Shop</a>

  <nav>
    <a href="/">Trang chủ</a>
    <a href="/products">Sản phẩm</a>
    <a href="/admin/users">Quản lý tài khoản</a>
    <a href="/admin/products">Quản lý sản phẩm</a>
    <a href="/auth/logout">Đăng xuất</a>
  </nav>
</header>

<div class="page-wrap">
  <h1>Quản lý sản phẩm</h1>

  <div style="margin-bottom: 18px;">
    <a href="/admin/products/add">
      <button>+ Thêm sản phẩm</button>
    </a>
  </div>

  <% if (products && products.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Ảnh</th>
          <th>Tên sản phẩm</th>
          <th>Thương hiệu</th>
          <th>Danh mục</th>
          <th>Giá</th>
          <th>Số lượng</th>
          <th>Người bán</th>
          <th>Thao tác</th>
        </tr>
      </thead>

      <tbody>
        <% products.forEach(p => { %>
          <tr>
            <td><%= p.id %></td>

            <td>
              <% if (p.image_url) { %>
                <img src="<%= p.image_url %>" class="thumb">
              <% } else { %>
                Chưa có ảnh
              <% } %>
            </td>

            <td>
              <strong><%= p.product_name %></strong>
              <div class="unit-price">
                Rating: <%= p.rating || 0 %>
              </div>
            </td>

            <td><%= p.brand || '' %></td>
            <td><%= p.category || '' %></td>
            <td><%= Number(p.price || 0).toLocaleString('vi-VN') %> đ</td>
            <td><%= p.quantity || 0 %></td>

            <td>
              <%= p.seller_name || 'Chưa gán' %>
            </td>

            <td>
              <a href="/admin/products/<%= p.id %>/edit">
                <button>Sửa</button>
              </a>

              <form action="/admin/products/<%= p.id %>/delete" method="POST" style="display:inline;">
                <button 
                  type="submit"
                  onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này không?')"
                >
                  Xóa
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class="error">Chưa có sản phẩm nào</p>
  <% } %>
</div>

</body>
</html>