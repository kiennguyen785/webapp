<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Sports Shop</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<header class="header">
  <a href="/" class="logo">Sports Shop</a>

  <form action="/products" method="GET" class="search">
    <input type="text" name="q" placeholder="Tìm sản phẩm thể thao...">
    <button>Tìm</button>
  </form>

  <nav>
    <a href="/">Trang chủ</a>
    <a href="/products">Sản phẩm</a>
    <a href="/cart">Giỏ hàng</a>

    <% if (user) { %>
      <div class="user-menu">
        <span><%= user.full_name %></span>

        <div class="dropdown">
          <a href="/profile">Thông tin cá nhân</a>
          <a href="/orders">Đơn hàng</a>

          <% if (user.role === 'admin') { %>
            <a href="/admin/users">Quản lý tài khoản</a>
            <a href="/admin/products">Quản lý sản phẩm</a>
          <% } %>

          <% if (user.role === 'seller') { %>
            <a href="/seller/products">Quản lý sản phẩm</a>
          <% } %>

          <a href="/auth/logout">Đăng xuất</a>
        </div>
      </div>
    <% } else { %>
      <a href="/auth/login">Đăng nhập</a>
      <a href="/auth/register">Đăng ký</a>
    <% } %>
  </nav>
</header>

<section class="banner">
  <h1>Website bán đồ thể thao</h1>
  <p>
    Giày thể thao, áo thể thao, bóng đá, phụ kiện gym,
    vợt cầu lông và nhiều sản phẩm khác
  </p>
</section>

<section class="category-box">
  <h2>Danh mục nổi bật</h2>

  <div class="categories">
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(c => { %>
        <a href="/products?category=<%= c.category %>">
          <%= c.category %>
        </a>
      <% }) %>
    <% } else { %>
      <a href="#">Giày thể thao</a>
      <a href="#">Áo thể thao</a>
      <a href="#">Gym</a>
      <a href="#">Bóng đá</a>
      <a href="#">Cầu lông</a>
    <% } %>
  </div>
</section>

<section>
  <h2 style="padding:0 40px;">Sản phẩm mới</h2>

  <div class="grid">
    <% if (products && products.length > 0) { %>
      <% products.forEach(p => { %>

        <div class="card">
          <a href="/products/<%= p.id %>">
            <img src="<%= p.image_url %>" alt="<%= p.product_name %>">

            <h3>
              <%= p.product_name %>
            </h3>
          </a>

          <p>
            <%= p.category %>
          </p>

          <strong>
            <%= Number(p.price).toLocaleString('vi-VN') %> đ
          </strong>

          <p class="stock-text">
            Còn lại: <%= p.quantity %>
          </p>

          <% if (user && (user.role === 'admin' || user.role === 'seller')) { %>

        <button disabled class="disabled-btn">
          Chỉ xem
        </button>

      <% } else if (p.quantity > 0) { %>

        <form action="/cart/add/<%= p.id %>" method="POST">
          <button>Thêm vào giỏ</button>
        </form>

      <% } else { %>

        <button disabled class="disabled-btn">
          Hết hàng
        </button>

      <% } %>
        </div>

      <% }) %>
    <% } else { %>
      <p style="padding:40px;">
        Chưa có sản phẩm trong database
      </p>
    <% } %>
  </div>
</section>

<footer class="footer">
  <div class="footer-grid">
    <div>
      <h3>Sports Shop</h3>
      <p>Website bán đồ thể thao trực tuyến.</p>
    </div>

    <div>
      <h4>Liên hệ</h4>
      <p>Email: support@sportshop.vn</p>
      <p>SĐT: 0123456789</p>
    </div>

    <div>
      <h4>Danh mục</h4>
      <p>Giày chạy bộ</p>
      <p>Bóng đá</p>
      <p>Cầu lông</p>
    </div>
  </div>
</footer>

</body>
</html>