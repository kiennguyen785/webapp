<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Đơn hàng</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<header class="header">
  <a href="/" class="logo">Sports Shop</a>

  <form action="/products" method="GET" class="search">
    <input type="text" name="q" placeholder="Tìm sản phẩm thể thao...">
    <button>Tìm</button>
  </form>

  <nav>
    <a href="/">Trang chủ</a>
    <a href="/products">Sản phẩm</a>
    <a href="/cart">Giỏ hàng</a>

    <% if (user) { %>
      <div class="user-menu">
        <span><%= user.full_name %></span>
        <div class="dropdown">
          <a href="/profile">Thông tin cá nhân</a>
          <a href="/orders">Lịch sử đặt hàng</a>

          <% if (user.role === 'admin') { %>
            <a href="/admin/users">Quản lý tài khoản</a>
            <a href="/admin/products">Quản lý sản phẩm</a>
          <% } %>

          <% if (user.role === 'seller') { %>
            <a href="/seller/products">Quản lý sản phẩm</a>
          <% } %>
          <a href="/auth/logout">Đăng xuất</a>
         </div>      
       </div>
       <% } else { %>
      <a href="/auth/login">Đăng nhập</a>
      <a href="/auth/register">Đăng ký</a>
    <% } %>
  </nav>
</header>


<main class="page-wrap">
  <h1>Lịch sử đặt hàng</h1>

  <table>
    <tr>
      <th>Mã đơn</th>
      <th>Tổng tiền</th>
      <th>Trạng thái</th>
      <th>Ngày tạo</th>
    </tr>

    <% orders.forEach(o => { %>
      <tr>
        <td>#<%= o.id %></td>
        <td><strong class="item-total"><%= Number(o.total_price).toLocaleString('vi-VN') %> đ</strong></td>
        <td><%= o.status %></td>
        <td><%= new Date(o.created_at).toLocaleString('vi-VN') %></td>
      </tr>
    <% }) %>
  </table>
</main>

<footer class="footer">
  <div class="footer-grid">
    <div>
      <h3>Sports Shop</h3>
      <p>Website bán đồ thể thao trực tuyến.</p>
    </div>
    <div>
      <h4>Liên hệ</h4>
      <p>Email: support@sportshop.vn</p>
      <p>SĐT: 0123456789</p>
    </div>
    <div>
      <h4>Danh mục</h4>
      <p>Giày chạy bộ</p>
      <p>Bóng đá</p>
      <p>Cầu lông</p>
    </div>
  </div>
</footer>

</body>
</html>